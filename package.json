{
  "name": "nestjs-woodcutter",
  "version": "1.0.0",
  "description": "NestJS module that logs through woodcutter, a small typed console logger built on winston",
  "keywords": [
    "nestjs",
    "nest",
    "logger",
    "logging",
    "woodcutter",
    "winston",
    "typescript"
  ],
  "author": "Olivier Schweitzer (https://www.oschweitzer.dev/)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oschweitzer/nestjs-woodcutter.git"
  },
  "bugs": "https://github.com/oschweitzer/nestjs-woodcutter/issues",
  "homepage": "https://github.com/oschweitzer/nestjs-woodcutter#readme",
  "engines": {
    "node": ">=20.19"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/mark-formats.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:smoke": "node scripts/smoke.mjs",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build && npm run test:smoke"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0 || ^12.0.0",
    "woodcutter": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@nestjs/common": "^12.5.0",
    "@nestjs/core": "^12.5.0",
    "@nestjs/platform-express": "^12.5.0",
    "@nestjs/testing": "^12.5.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.10.1",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.0.0",
    "rxjs": "^7.8.2",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0",
    "woodcutter": "^3.0.0"
  }
}
